#define GITHUB_RELEASE_URL L"https://github.com/Streetisreal/UBrowse-Explorer/releases/latest"

struct BrowserTab {
    ComPtr<ICoreWebView2Controller> controller;
    ComPtr<ICoreWebView2> webview;
    std::wstring currentUrl;
};

struct Bookmark {
    std::wstring name;
    std::wstring url;
};

HWND hWndMain, hWndEdit, hWndButton, hWndBack, hWndForward, hWndStatus, hWndTabs, hWndNewTab, hWndCloseTab, hWndSettings, hWndIncognito;
HWND hWndSettingsWindow = NULL;
WNDPROC OldEditProc;

ComPtr<ICoreWebView2Environment> g_env;
std::vector<BrowserTab> g_tabs;
std::vector<Bookmark> g_bookmarks;
std::vector<HWND> g_bookmarkButtons;

BOOL g_isDarkMode = TRUE;
BOOL g_extensionsEnabled = TRUE;
BOOL g_isIncognito = FALSE;
int g_searchEngine = 0; 
std::wstring g_homePageUrl = L"https://www.streetisreal.com/ubrowse-landing-page/";

const wchar_t* FLAPPY_BIRD_HTML = LR"html(
<!DOCTYPE html><html><head><style>body{margin:0;overflow:hidden;background:#70c5ce;font-family:Arial;user-select:none;}canvas{display:block;}#ui{position:absolute;top:20px;left:20px;color:white;font-size:32px;font-weight:bold;text-shadow:3px 3px 0 #000;z-index:10;}</style></head><body>
<div id="ui">Score: <span id="score">0</span></div><canvas id="gameCanvas"></canvas>
<script>
    const canvas = document.getElementById("gameCanvas"); const ctx = canvas.getContext("2d");
    function resize() { canvas.width = window.innerWidth; canvas.height = window.innerHeight; }
    window.addEventListener("resize", resize); resize();
    let frames = 0, score = 0, gameOver = false;
    const bird = { x: window.innerWidth * 0.2, y: 150, width: 34, height: 24, gravity: 0.35, jump: 6.5, velocity: 0 };
    let pipes = []; const pipeWidth = 60; const gap = 160;
    window.addEventListener("keydown", (e) => { if (e.code === "Space") flap(); }); window.addEventListener("mousedown", flap);
    function flap() { if (gameOver) { bird.y = 150; bird.velocity = 0; pipes = []; score = 0; frames = 0; document.getElementById("score").innerText = score; gameOver = false; loop(); } else { bird.velocity = -bird.jump; } }
    function draw() { ctx.fillStyle = "#70c5ce"; ctx.fillRect(0, 0, canvas.width, canvas.height); ctx.fillStyle = "#f2b736"; ctx.fillRect(bird.x, bird.y, bird.width, bird.height); ctx.fillStyle = "#73bf2e"; for (let p of pipes) { ctx.fillRect(p.x, 0, pipeWidth, p.top); ctx.fillRect(p.x, canvas.height - p.bottom, pipeWidth, p.bottom); } ctx.fillStyle = "#ded895"; ctx.fillRect(0, canvas.height - 30, canvas.width, 30); }
    function update() { bird.velocity += bird.gravity; bird.y += bird.velocity; if (bird.y + bird.height >= canvas.height - 30 || bird.y <= 0) gameOver = true; if (frames % 120 === 0) { let topHeight = Math.max(40, Math.random() * (canvas.height - gap - 80)); pipes.push({ x: canvas.width, top: topHeight, bottom: canvas.height - gap - topHeight, passed: false }); } for (let p of pipes) { p.x -= 3.5; if (bird.x < p.x + pipeWidth && bird.x + bird.width > p.x && (bird.y < p.top || bird.y + bird.height > canvas.height - p.bottom)) gameOver = true; if (p.x + pipeWidth < bird.x && !p.passed) { score++; p.passed = true; document.getElementById("score").innerText = score; } } pipes = pipes.filter(p => p.x + pipeWidth > 0); frames++; }
    function loop() { if (!gameOver) { update(); draw(); requestAnimationFrame(loop); } else { ctx.fillStyle = "black"; ctx.font = "bold 40px Arial"; ctx.fillText("Game Over - Press Space to Restart", canvas.width / 2 - 320, canvas.height / 2); } } loop();
</script></body></html>
)html";

const wchar_t* UBROWSE_ABOUT_HTML = LR"html(
<!DOCTYPE html><html><head><title>About UBrowse</title>
<style>body{font-family:'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background:#1e1e1e; color:#fff; text-align:center; padding-top:50px;} h1{color:#4da6ff; font-size:48px; margin-bottom: 5px;} .container{background:#2a2a2a; border-radius:10px; display:inline-block; padding:40px; box-shadow: 0 4px 8px rgba(0,0,0,0.5);} p{color:#ccc; font-size:18px;} a{color:#70c5ce;}</style>
</head><body><div class="container"><h1>UBrowse Explorer</h1><p>Version 1.4</p><p>A lightweight, custom web browser built with C++ and Microsoft Edge WebView2.</p><p>&copy; 2026 Streetisreal. All rights reserved.</p></div></body></html>
)html";

std::wstring GenerateHistoryHTML() {
    std::wstring html = L"<html><head><title>History</title><style>body{font-family:Segoe UI, Arial; background:#1e1e1e; color:#e0e0e0; padding:20px;} a{color:#4da6ff; text-decoration:none;} a:hover{text-decoration:underline;} li{margin-bottom:10px;}</style></head><body><h1>Browsing History</h1><ul>";
    std::wifstream file("history.txt");
    std::wstring line;
    while (std::getline(file, line)) {
        size_t delim = line.find(L'|');
        if (delim != std::wstring::npos) {
            std::wstring url = line.substr(0, delim);
            std::wstring title = line.substr(delim + 1);
            html += L"<li><a href='" + url + L"'>" + title + L"</a><br><small style='color:#888'>" + url + L"</small></li>";
        }
    }
    html += L"</ul></body></html>";
    return html;
}

std::wstring GetSearchUrl(const std::wstring& query) {
    std::wstring searchBase;
    if (g_searchEngine == 1) searchBase = L"https://www.bing.com/search?q=";
    else if (g_searchEngine == 2) searchBase = L"https://duckduckgo.com/?q=";
    else searchBase = L"https://www.google.com/search?q=";

    std::wstring encoded;
    for (wchar_t c : query) {
        if (iswalnum(c)) encoded += c;
        else if (c == L' ') encoded += L'+';
        else {
            wchar_t buf[10];
            swprintf(buf, 10, L"%%%02X", (unsigned char)c);
            encoded += buf;
        }
    }
    return searchBase + encoded;
}

void LoadSettings() {
    std::ifstream file("config.conf");
    if (file.is_open()) {
        file >> g_isDarkMode >> g_extensionsEnabled;
        if (!(file >> g_searchEngine)) g_searchEngine = 0;
        std::string url;
        if (file >> url) {
            int size_needed = MultiByteToWideChar(CP_UTF8, 0, url.c_str(), (int)url.size(), NULL, 0);
            g_homePageUrl = std::wstring(size_needed, 0);
            MultiByteToWideChar(CP_UTF8, 0, url.c_str(), (int)url.size(), &g_homePageUrl[0], size_needed);
        }
        file.close();
    }
}

void SaveSettings() {
    std::ofstream file("config.conf");
    if (file.is_open()) {
        int size_needed = WideCharToMultiByte(CP_UTF8, 0, g_homePageUrl.c_str(), (int)g_homePageUrl.size(), NULL, 0, NULL, NULL);
        std::string url(size_needed, 0);
        WideCharToMultiByte(CP_UTF8, 0, g_homePageUrl.c_str(), (int)g_homePageUrl.size(), &url[0], size_needed, NULL, NULL);
        file << g_isDarkMode << " " << g_extensionsEnabled << " " << g_searchEngine << " " << url;
        file.close();
    }
}

void LoadBookmarks(HWND parent) {
    std::wifstream file("bookmarks.txt");
    if (!file.is_open()) return;

    std::wstring line;
    int id = BOOKMARK_BASE_ID;
    while (std::getline(file, line)) {
        size_t delim = line.find(L'|');
        if (delim != std::wstring::npos) {
            Bookmark b;
            b.name = line.substr(0, delim);
            b.url = line.substr(delim + 1);
            g_bookmarks.push_back(b);

            HWND btn = CreateWindowEx(0, _T("BUTTON"), b.name.c_str(), WS_CHILD | WS_VISIBLE | BS_PUSHBUTTON, 0, 0, 0, 0, parent, (HMENU)(UINT_PTR)id, GetModuleHandle(NULL), NULL);
            SendMessage(btn, WM_SETFONT, (WPARAM)GetStockObject(DEFAULT_GUI_FONT), TRUE);
            g_bookmarkButtons.push_back(btn);
            id++;
        }
    }
}

std::wstring LoadExtensionScript(const fs::path& path) {
    std::ifstream file(path, std::ios::in | std::ios::binary);
    if (!file) return L"";
    std::string contents((std::istreambuf_iterator<char>(file)), std::istreambuf_iterator<char>());
    int size_needed = MultiByteToWideChar(CP_UTF8, 0, contents.c_str(), (int)contents.size(), NULL, 0);
    std::wstring wcontents(size_needed, 0);
    MultiByteToWideChar(CP_UTF8, 0, contents.c_str(), (int)contents.size(), &wcontents[0], size_needed);
    return wcontents;
}

void CreateNewTab(std::wstring startUrl) {
    if (!g_env) return;

    int newTabIndex = (int)g_tabs.size();
    g_tabs.push_back(BrowserTab());
    g_tabs[newTabIndex].currentUrl = startUrl;

    TCITEM tie = { 0 };
    tie.mask = TCIF_TEXT;
    tie.pszText = (LPWSTR)L"New Tab";
    TabCtrl_InsertItem(hWndTabs, newTabIndex, &tie);
    TabCtrl_SetCurSel(hWndTabs, newTabIndex);

    g_env->CreateCoreWebView2Controller(hWndMain, Callback<ICoreWebView2CreateCoreWebView2ControllerCompletedHandler>(
        [newTabIndex, startUrl](HRESULT result, ICoreWebView2Controller* controller) -> HRESULT {
            if (controller != nullptr) {
                int activeIndex = -1;
                for (int i = 0; i < g_tabs.size(); i++) {
                    if (!g_tabs[i].controller) {
                        activeIndex = i; break;
                    }
                }

                if (activeIndex != -1) {
                    g_tabs[activeIndex].controller = controller;
                    g_tabs[activeIndex].webview = nullptr;
                    controller->get_CoreWebView2(&g_tabs[activeIndex].webview);
                    auto webview = g_tabs[activeIndex].webview;

                    EventRegistrationToken token;
                    webview->add_DocumentTitleChanged(
                        Callback<ICoreWebView2DocumentTitleChangedEventHandler>(
                            [](ICoreWebView2* sender, IUnknown* args) -> HRESULT {
                                int foundIndex = -1;
                                for (int i = 0; i < g_tabs.size(); i++) {
                                    if (g_tabs[i].webview.Get() == sender) {
                                        foundIndex = i; break;
                                    }
                                }
                                if (foundIndex != -1) {
                                    LPWSTR title;
                                    sender->get_DocumentTitle(&title);
                                    TCITEM tie = { 0 };
                                    tie.mask = TCIF_TEXT;
                                    tie.pszText = title;
                                    TabCtrl_SetItem(hWndTabs, foundIndex, &tie);
                                    CoTaskMemFree(title);
                                }
                                return S_OK;
                            }).Get(), &token);

                    webview->AddWebResourceRequestedFilter(L"*", COREWEBVIEW2_WEB_RESOURCE_CONTEXT_ALL);
                    webview->add_WebResourceRequested(
                        Callback<ICoreWebView2WebResourceRequestedEventHandler>(
                            [](ICoreWebView2* sender, ICoreWebView2WebResourceRequestedEventArgs* args) -> HRESULT {
                                ComPtr<ICoreWebView2WebResourceRequest> request;
                                args->get_Request(&request);
                                LPWSTR uri;
                                request->get_Uri(&uri);
                                if (uri) {
                                    std::wstring url(uri);
                                    CoTaskMemFree(uri);

                                    if (url.rfind(L"chrome-extension://", 0) == 0) {
                                        return S_OK;
                                    }

                                    const wchar_t* blockedDomains[] = {
                                        L"doubleclick.net", L"googleadservices.com", L"googlesyndication.com",
                                        L"amazon-adsystem.com", L"taboola.com", L"outbrain.com"
                                    };
                                    for (const auto& domain : blockedDomains) {
                                        if (url.find(domain) != std::wstring::npos) {
                                            ComPtr<ICoreWebView2WebResourceResponse> response;
                                            g_env->CreateWebResourceResponse(nullptr, 403, L"Blocked", L"", &response);
                                            args->put_Response(response.Get());
                                            SendMessage(hWndStatus, SB_SETTEXT, 0, (LPARAM)_T("Domain Ad Blocked!"));
                                            break;
                                        }
                                    }
                                }
                                return S_OK;
                            }).Get(), nullptr);

                    LPCWSTR jsScript = L" \
                        const style = document.createElement('style'); \
                        style.innerHTML = ` \
                            ytd-ad-slot-renderer, \
                            ytd-companion-slot-renderer, \
                            ytd-player-legacy-desktop-watch-ads-renderer, \
                            ytd-promoted-sparkles-web-renderer, \
                            .ytd-video-masthead-ad-v3-renderer, \
                            .ytp-ad-image-overlay, \
                            div#root.style-scope.ytd-display-ad-renderer, \
                            div.ad-container { display: none !important; } \
                        `; \
                        document.head.appendChild(style); \
                        setInterval(() => { \
                            const skipBtn = document.querySelector('.ytp-ad-skip-button, .ytp-ad-skip-button-modern, .ytp-skip-ad-button'); \
                            if (skipBtn) { skipBtn.click(); } \
                            const isAdPlaying = document.querySelector('.ad-showing, .ytp-ad-player-overlay'); \
                            if (isAdPlaying) { \
                                const video = document.querySelector('video'); \
                                if (video && !isNaN(video.duration)) { \
                                    video.playbackRate = 16.0; \
                                    video.currentTime = video.duration - 0.1; \
                                } \
                            } \
                            const adOverlay = document.querySelector('.ytp-ad-overlay-close-button'); \
                            if (adOverlay) { adOverlay.click(); } \
                        }, 50); \
                    ";
                    webview->AddScriptToExecuteOnDocumentCreated(jsScript, nullptr);

                    if (g_extensionsEnabled) {
                        fs::path extDir = "extensions";
                        if (!fs::exists(extDir)) {
                            fs::create_directory(extDir);
                        }
                        else {
                            for (const auto& entry : fs::directory_iterator(extDir)) {
                                if (entry.path().extension() == ".js") {
                                    std::wstring customScript = LoadExtensionScript(entry.path());
                                    if (!customScript.empty()) {
                                        webview->AddScriptToExecuteOnDocumentCreated(customScript.c_str(), nullptr);
                                    }
                                }
                            }
                        }
                    }

                    for (int i = 0; i < g_tabs.size(); i++) {
                        if (g_tabs[i].controller) g_tabs[i].controller->put_IsVisible(i == activeIndex);
                    }

                    RECT bounds; GetClientRect(hWndMain, &bounds);
                    ResizeLayout(bounds.right, bounds.bottom);

                    if (startUrl == L"ubrowse://flap") {
                        webview->NavigateToString(FLAPPY_BIRD_HTML);
                    }
                    else if (startUrl == L"ubrowse://history") {
                        std::wstring histHtml = GenerateHistoryHTML();
                        webview->NavigateToString(histHtml.c_str());
                    }
                    else if (startUrl == L"ubrowse://about") {
                        webview->NavigateToString(UBROWSE_ABOUT_HTML);
                    }
                    else {
                        webview->Navigate(startUrl.c_str());
                    }
                }
            }
            return S_OK;
        }).Get());
}

LRESULT CALLBACK EditProc(HWND hWnd, UINT msg, WPARAM wParam, LPARAM lParam) {
    if (msg == WM_KEYDOWN && wParam == VK_RETURN) {
        SendMessage(GetParent(hWnd), WM_COMMAND, MAKEWPARAM(IDC_GO_BUTTON, 0), 0);
        return 0;
    }
    return CallWindowProc(OldEditProc, hWnd, msg, wParam, lParam);
}

void ApplyTheme(HWND hwnd, BOOL darkMode) {
    DwmSetWindowAttribute(hwnd, DWMWA_USE_IMMERSIVE_DARK_MODE, &darkMode, sizeof(darkMode));
    InvalidateRect(hwnd, NULL, TRUE);
}

int CALLBACK WinMain(_In_ HINSTANCE hInstance, _In_opt_ HINSTANCE hPrevInstance, _In_ LPSTR lpCmdLine, _In_ int nCmdShow) {
    std::wstring cmdLine = GetCommandLineW();
    if (cmdLine.find(L"--incognito") != std::wstring::npos) {
        g_isIncognito = TRUE;
        g_isDarkMode = TRUE;
    }
    else {
        LoadSettings();
    }

    fs::path ublockFullPath = fs::absolute("ublock");
    if (fs::exists(ublockFullPath) && !g_isIncognito) {
        std::wstring argString = L"--load-extension=\"" + ublockFullPath.wstring() + L"\"";
        SetEnvironmentVariableW(L"WEBVIEW2_ADDITIONAL_BROWSER_ARGUMENTS", argString.c_str());
    }

    INITCOMMONCONTROLSEX icex; icex.dwSize = sizeof(INITCOMMONCONTROLSEX); icex.dwICC = ICC_BAR_CLASSES | ICC_TAB_CLASSES;
    InitCommonControlsEx(&icex);

    WNDCLASSEX wcex = { 0 }; wcex.cbSize = sizeof(WNDCLASSEX); wcex.style = CS_HREDRAW | CS_VREDRAW;
    wcex.lpfnWndProc = WndProc; wcex.hInstance = hInstance; wcex.hCursor = LoadCursor(NULL, IDC_ARROW);
    wcex.hbrBackground = (HBRUSH)(g_isDarkMode ? GetStockObject(BLACK_BRUSH) : (HBRUSH)(COLOR_BTNFACE + 1));
    wcex.lpszClassName = _T("BrowserWindowClass");
    RegisterClassEx(&wcex);

    WNDCLASSEX wcexSettings = { 0 }; wcexSettings.cbSize = sizeof(WNDCLASSEX); wcexSettings.lpfnWndProc = SettingsWndProc;
    wcexSettings.hInstance = hInstance; wcexSettings.hCursor = LoadCursor(NULL, IDC_ARROW);
    wcexSettings.hbrBackground = (HBRUSH)(COLOR_BTNFACE + 1); wcexSettings.lpszClassName = _T("SettingsWindowClass");
    RegisterClassEx(&wcexSettings);

    std::wstring title = g_isIncognito ? L"UBrowse Explorer 1.3 (Incognito Mode)" : L"UBrowse Explorer 1.3";
    hWndMain = CreateWindow(_T("BrowserWindowClass"), title.c_str(), WS_OVERLAPPEDWINDOW, CW_USEDEFAULT, CW_USEDEFAULT, 1200, 800, NULL, NULL, hInstance, NULL);
    DwmSetWindowAttribute(hWndMain, DWMWA_USE_IMMERSIVE_DARK_MODE, &g_isDarkMode, sizeof(g_isDarkMode));
    RegisterHotKey(hWndMain, EASTER_EGG_HOTKEY_ID, MOD_CONTROL | MOD_SHIFT | MOD_ALT, VK_F5);

    hWndBack = CreateWindowEx(0, _T("BUTTON"), _T("<"), WS_CHILD | WS_VISIBLE | BS_PUSHBUTTON, 0, 0, 0, 0, hWndMain, (HMENU)IDC_BACK_BUTTON, hInstance, NULL);
    hWndForward = CreateWindowEx(0, _T("BUTTON"), _T(">"), WS_CHILD | WS_VISIBLE | BS_PUSHBUTTON, 0, 0, 0, 0, hWndMain, (HMENU)IDC_FORWARD_BUTTON, hInstance, NULL);
    hWndEdit = CreateWindowEx(0, _T("EDIT"), g_homePageUrl.c_str(), WS_CHILD | WS_VISIBLE | WS_BORDER | ES_AUTOHSCROLL, 0, 0, 0, 0, hWndMain, (HMENU)IDC_ADDRESS_BAR, hInstance, NULL);
    hWndButton = CreateWindowEx(0, _T("BUTTON"), _T("Go"), WS_CHILD | WS_VISIBLE | BS_PUSHBUTTON, 0, 0, 0, 0, hWndMain, (HMENU)IDC_GO_BUTTON, hInstance, NULL);
    hWndNewTab = CreateWindowEx(0, _T("BUTTON"), _T("+"), WS_CHILD | WS_VISIBLE | BS_PUSHBUTTON, 0, 0, 0, 0, hWndMain, (HMENU)IDC_NEW_TAB_BUTTON, hInstance, NULL);
    hWndCloseTab = CreateWindowEx(0, _T("BUTTON"), _T("X"), WS_CHILD | WS_VISIBLE | BS_PUSHBUTTON, 0, 0, 0, 0, hWndMain, (HMENU)IDC_CLOSE_TAB_BUTTON, hInstance, NULL);
    hWndSettings = CreateWindowEx(0, _T("BUTTON"), _T("Settings"), WS_CHILD | WS_VISIBLE | BS_PUSHBUTTON, 0, 0, 0, 0, hWndMain, (HMENU)IDC_SETTINGS_BUTTON, hInstance, NULL);
    hWndIncognito = CreateWindowEx(0, _T("BUTTON"), _T("Incog"), WS_CHILD | WS_VISIBLE | BS_PUSHBUTTON, 0, 0, 0, 0, hWndMain, (HMENU)IDC_INCOGNITO_BUTTON, hInstance, NULL);

    LoadBookmarks(hWndMain);

    hWndTabs = CreateWindowEx(0, WC_TABCONTROL, _T(""), WS_CHILD | WS_VISIBLE | TCS_TABS | TCS_FIXEDWIDTH, 0, 0, 0, 0, hWndMain, (HMENU)IDC_TAB_CONTROL, hInstance, NULL);
    SetWindowTheme(hWndTabs, L"Explorer", NULL);
    hWndStatus = CreateWindowEx(0, STATUSCLASSNAME, NULL, WS_CHILD | WS_VISIBLE | SBARS_SIZEGRIP, 0, 0, 0, 0, hWndMain, (HMENU)IDC_STATUS_BAR, hInstance, NULL);

    HFONT hFont = (HFONT)GetStockObject(DEFAULT_GUI_FONT);
    SendMessage(hWndBack, WM_SETFONT, (WPARAM)hFont, TRUE); SendMessage(hWndForward, WM_SETFONT, (WPARAM)hFont, TRUE);
    SendMessage(hWndEdit, WM_SETFONT, (WPARAM)hFont, TRUE); SendMessage(hWndButton, WM_SETFONT, (WPARAM)hFont, TRUE);
    SendMessage(hWndNewTab, WM_SETFONT, (WPARAM)hFont, TRUE); SendMessage(hWndCloseTab, WM_SETFONT, (WPARAM)hFont, TRUE);
    SendMessage(hWndSettings, WM_SETFONT, (WPARAM)hFont, TRUE); SendMessage(hWndIncognito, WM_SETFONT, (WPARAM)hFont, TRUE);
    SendMessage(hWndTabs, WM_SETFONT, (WPARAM)hFont, TRUE);

    OldEditProc = (WNDPROC)SetWindowLongPtr(hWndEdit, GWLP_WNDPROC, (LONG_PTR)EditProc);

    ShowWindow(hWndMain, nCmdShow); UpdateWindow(hWndMain);

    RECT bounds;
    GetClientRect(hWndMain, &bounds);
    ResizeLayout(bounds.right, bounds.bottom);

    std::wstring userDataFolder = g_isIncognito ? (fs::temp_directory_path() / L"UBrowseIncognito").wstring() : L"";
    LPCWSTR folderPtr = userDataFolder.empty() ? nullptr : userDataFolder.c_str();

    CreateCoreWebView2EnvironmentWithOptions(nullptr, folderPtr, nullptr,
        Callback<ICoreWebView2CreateCoreWebView2EnvironmentCompletedHandler>(
            [](HRESULT result, ICoreWebView2Environment* env) -> HRESULT {
                if (SUCCEEDED(result)) { g_env = env; CreateNewTab(g_homePageUrl); }
                return S_OK;
            }).Get());

    MSG msg; while (GetMessage(&msg, NULL, 0, 0)) { TranslateMessage(&msg); DispatchMessage(&msg); }
    return (int)msg.wParam;
}

void ResizeLayout(int width, int height) {
    if (!hWndEdit || !hWndTabs) return;
    int barHeight = 30; int navBtnWidth = 30; int goBtnWidth = 40; int settingsBtnWidth = 60; int incogBtnWidth = 50;

    SendMessage(hWndStatus, WM_SIZE, 0, 0);
    RECT statusRect; GetClientRect(hWndStatus, &statusRect); int statusHeight = statusRect.bottom - statusRect.top;

    MoveWindow(hWndBack, 5, 5, navBtnWidth, barHeight, TRUE);
    MoveWindow(hWndForward, 35, 5, navBtnWidth, barHeight, TRUE);

    int addressBarX = 70;
    int addressBarWidth = width - addressBarX - goBtnWidth - navBtnWidth - navBtnWidth - settingsBtnWidth - incogBtnWidth - 30;
    MoveWindow(hWndEdit, addressBarX, 5, addressBarWidth, barHeight, TRUE);

    int cx = addressBarX + addressBarWidth + 5; MoveWindow(hWndButton, cx, 5, goBtnWidth, barHeight, TRUE); cx += goBtnWidth + 5;
    MoveWindow(hWndNewTab, cx, 5, navBtnWidth, barHeight, TRUE); cx += navBtnWidth + 5;
    MoveWindow(hWndCloseTab, cx, 5, navBtnWidth, barHeight, TRUE); cx += navBtnWidth + 5;
    MoveWindow(hWndIncognito, cx, 5, incogBtnWidth, barHeight, TRUE); cx += incogBtnWidth + 5;
    MoveWindow(hWndSettings, cx, 5, settingsBtnWidth, barHeight, TRUE);

    int bookmarkY = 40;
    int bookmarkHeight = g_bookmarks.empty() ? 0 : 25;
    if (!g_bookmarks.empty()) {
        int bx = 5;
        for (HWND btn : g_bookmarkButtons) {
            int bWidth = 100; 
            MoveWindow(btn, bx, bookmarkY, bWidth, bookmarkHeight, TRUE);
            bx += bWidth + 5;
        }
    }

    int tabY = bookmarkY + bookmarkHeight;
    int tabHeight = 25;
    MoveWindow(hWndTabs, 0, tabY, width, tabHeight, TRUE);

    int currentTab = TabCtrl_GetCurSel(hWndTabs);
    if (currentTab >= 0 && currentTab < g_tabs.size() && g_tabs[currentTab].controller) {
        RECT bounds = { 0, tabY + tabHeight, width, height - statusHeight - (tabY + tabHeight) };
        g_tabs[currentTab].controller->put_Bounds(bounds);
    }
}

LRESULT CALLBACK SettingsWndProc(HWND hWnd, UINT message, WPARAM wParam, LPARAM lParam) {
    switch (message) {
    case WM_CREATE: {
        HWND hChkDark = CreateWindowEx(0, L"BUTTON", L"Enable Dark Mode", WS_CHILD | WS_VISIBLE | BS_AUTOCHECKBOX, 20, 20, 150, 25, hWnd, (HMENU)IDC_CHK_DARKMODE, GetModuleHandle(NULL), NULL);
        SendMessage(hChkDark, BM_SETCHECK, g_isDarkMode ? BST_CHECKED : BST_UNCHECKED, 0);

        HWND hChkExt = CreateWindowEx(0, L"BUTTON", L"Enable Extensions", WS_CHILD | WS_VISIBLE | BS_AUTOCHECKBOX, 20, 50, 150, 25, hWnd, (HMENU)IDC_CHK_EXTENSIONS, GetModuleHandle(NULL), NULL);
        SendMessage(hChkExt, BM_SETCHECK, g_extensionsEnabled ? BST_CHECKED : BST_UNCHECKED, 0);

        CreateWindowEx(0, L"STATIC", L"Preferred Search:", WS_CHILD | WS_VISIBLE, 20, 90, 150, 20, hWnd, (HMENU)IDC_LBL_SEARCH, GetModuleHandle(NULL), NULL);
        HWND hCmb = CreateWindowEx(0, L"COMBOBOX", L"", WS_CHILD | WS_VISIBLE | CBS_DROPDOWNLIST | WS_VSCROLL, 160, 90, 150, 100, hWnd, (HMENU)IDC_CMB_SEARCH, GetModuleHandle(NULL), NULL);
        SendMessage(hCmb, CB_ADDSTRING, 0, (LPARAM)L"Google");
        SendMessage(hCmb, CB_ADDSTRING, 0, (LPARAM)L"Bing");
        SendMessage(hCmb, CB_ADDSTRING, 0, (LPARAM)L"DuckDuckGo");
        SendMessage(hCmb, CB_SETCURSEL, g_searchEngine, 0);

        CreateWindowEx(0, L"STATIC", L"Homepage URL:", WS_CHILD | WS_VISIBLE, 20, 130, 150, 20, hWnd, (HMENU)IDC_LBL_HOMEPAGE, GetModuleHandle(NULL), NULL);
        HWND hEditHome = CreateWindowEx(0, L"EDIT", g_homePageUrl.c_str(), WS_CHILD | WS_VISIBLE | WS_BORDER | ES_AUTOHSCROLL, 20, 150, 340, 25, hWnd, (HMENU)IDC_EDIT_HOMEPAGE, GetModuleHandle(NULL), NULL);

        CreateWindowEx(0, L"BUTTON", L"Save Settings", WS_CHILD | WS_VISIBLE | BS_PUSHBUTTON, 130, 200, 120, 30, hWnd, (HMENU)IDC_BTN_SAVESETTINGS, GetModuleHandle(NULL), NULL);

        EnumChildWindows(hWnd, [](HWND hwnd, LPARAM lParam) -> BOOL {
            SendMessage(hwnd, WM_SETFONT, (WPARAM)GetStockObject(DEFAULT_GUI_FONT), TRUE);
            return TRUE;
            }, 0);
        break;
    }
    case WM_COMMAND: {
        int wmId = LOWORD(wParam);
        if (wmId == IDC_BTN_SAVESETTINGS) {
            HWND hChkDark = GetDlgItem(hWnd, IDC_CHK_DARKMODE);
            g_isDarkMode = (SendMessage(hChkDark, BM_GETCHECK, 0, 0) == BST_CHECKED);

            HWND hChkExt = GetDlgItem(hWnd, IDC_CHK_EXTENSIONS);
            g_extensionsEnabled = (SendMessage(hChkExt, BM_GETCHECK, 0, 0) == BST_CHECKED);

            g_searchEngine = SendMessage(GetDlgItem(hWnd, IDC_CMB_SEARCH), CB_GETCURSEL, 0, 0);

            HWND hEditHome = GetDlgItem(hWnd, IDC_EDIT_HOMEPAGE);
            int len = GetWindowTextLength(hEditHome);
            std::vector<wchar_t> buffer(len + 1);
            GetWindowText(hEditHome, &buffer[0], len + 1);
            g_homePageUrl = std::wstring(&buffer[0]);

            SaveSettings();

            ApplyTheme(hWndMain, g_isDarkMode);
            InvalidateRect(hWndMain, NULL, TRUE);

            MessageBox(hWnd, L"Settings saved successfully!\n\nNote: Restart the browser to apply extension changes.", L"UBrowse Settings", MB_OK | MB_ICONINFORMATION);
            DestroyWindow(hWnd);
        }
        break;
    }
    case WM_CLOSE: DestroyWindow(hWnd); break;
    case WM_DESTROY: hWndSettingsWindow = NULL; break;
    default: return DefWindowProc(hWnd, message, wParam, lParam);
    }
    return 0;
}

LRESULT CALLBACK WndProc(HWND hWnd, UINT message, WPARAM wParam, LPARAM lParam) {
    switch (message) {
    case WM_SIZE:
        ResizeLayout(static_cast<int>(LOWORD(lParam)), static_cast<int>(HIWORD(lParam)));
        break;

    case WM_CTLCOLORSTATIC:
    case WM_CTLCOLOREDIT:
    case WM_CTLCOLORBTN: {
        if (g_isDarkMode) {
            SetTextColor((HDC)wParam, RGB(255, 255, 255));
            SetBkColor((HDC)wParam, RGB(32, 32, 32));
            static HBRUSH hDarkBrush = CreateSolidBrush(RGB(32, 32, 32));
            return (INT_PTR)hDarkBrush;
        }
        return DefWindowProc(hWnd, message, wParam, lParam);
    }

    case WM_NOTIFY: {
        if (((LPNMHDR)lParam)->code == TCN_SELCHANGE) {
            int currentTab = TabCtrl_GetCurSel(hWndTabs);
            for (size_t i = 0; i < g_tabs.size(); i++) {
                if (g_tabs[i].controller) g_tabs[i].controller->put_IsVisible(i == (size_t)currentTab);
            }
            RECT rect; GetClientRect(hWnd, &rect);
            ResizeLayout(static_cast<int>(rect.right), static_cast<int>(rect.bottom));
        }
        break;
    }

    case WM_COMMAND: {
        int wmId = LOWORD(wParam);
        int currentTab = TabCtrl_GetCurSel(hWndTabs);

        if (wmId >= BOOKMARK_BASE_ID && wmId < BOOKMARK_BASE_ID + g_bookmarks.size()) {
            int idx = wmId - BOOKMARK_BASE_ID;
            std::wstring bUrl = g_bookmarks[idx].url;
            if (currentTab >= 0 && currentTab < g_tabs.size() && g_tabs[currentTab].webview) {
                g_tabs[currentTab].webview->Navigate(bUrl.c_str());
                SetWindowTextW(hWndEdit, bUrl.c_str());
            }
            else {
                CreateNewTab(bUrl);
            }
            return 0;
        }

        if (wmId == IDC_INCOGNITO_BUTTON) {
            wchar_t exePath[MAX_PATH];
            GetModuleFileName(NULL, exePath, MAX_PATH);
            ShellExecute(NULL, L"open", exePath, L"--incognito", NULL, SW_SHOW);
        }
        else if (wmId == IDC_SETTINGS_BUTTON) {
            if (!IsWindow(hWndSettingsWindow)) {
